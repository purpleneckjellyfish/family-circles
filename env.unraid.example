# Copy to /mnt/user/appdata/family-circles/compose/.env on Unraid
# Used by docker-compose.unraid-stack.yml (Compose Manager / Docker tab)

# Required
AUTH_SECRET=replace-with-a-long-random-secret
APP_URL=https://circles.yourdomain.com
AUTH_URL=https://circles.yourdomain.com

# Postgres (compose wires DATABASE_URL for you)
POSTGRES_PASSWORD=change-me-strong-db-password

# Web push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Digest cron bearer token
CRON_SECRET=replace-with-random

# Optional: pin an Actions image tag instead of :latest
# FAMILY_CIRCLES_IMAGE=ghcr.io/purpleneckjellyfish/family-circles:latest

# Unraid file ownership (nobody:users). Entrypoint chowns /data on start.
PUID=99
PGID=100
