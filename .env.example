# Family Circles local / Docker env template
# Copy to `.env` and fill in secrets before running.

# Postgres connection string
DATABASE_URL=postgres://familycircles:familycircles@127.0.0.1:5432/familycircles

# Auth.js / session signing secret (generate a long random string)
AUTH_SECRET=replace-with-a-long-random-secret

# Auth.js canonical URL (optional; defaults from request / APP_URL)
AUTH_URL=http://127.0.0.1:43127

# Public URL of this instance (used for invites, PWA, federation later)
# Production push + install require HTTPS (except localhost).
APP_URL=http://127.0.0.1:43127

# Where original media files are stored (Docker Compose mounts this at /data)
DATA_DIR=./data

# Web Push (Phase 4) — required for notifications
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Hourly digest / quiet-hours flush — Authorization: Bearer <CRON_SECRET>
# curl -X POST -H "Authorization: Bearer $CRON_SECRET" "$APP_URL/api/cron/digest"
CRON_SECRET=
